---
import ThemeArt from './ThemeArt.astro';
import { LINKS } from '../config';
import { DEFAULT_THEME, nextTheme, themeById } from '../themes.mjs';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const nav = [
  { href: `${base}#screens`, label: 'Screens' },
  { href: `${base}#features`, label: 'Features' },
  { href: `${base}#install`, label: 'Install' },
  { href: `${base}#support`, label: 'Support' },
];
// The theme button's no-JS state; Base.astro's theme cycle keeps it current.
const theme = themeById(DEFAULT_THEME);
const after = nextTheme(theme.id);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={base} aria-label="nu11signal home">
      <ThemeArt kind="mark" class="brand__mark" aria-hidden="true" />
      <span class="brand__word" aria-hidden="true">NU11SIGNAL</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={LINKS.repo} rel="noopener">GitHub</a></li>
      </ul>
    </nav>

    <div class="toggles">
      <button type="button" class="hud-btn hud-btn--small" data-theme-toggle data-current={theme.id} title={`Color theme: ${theme.label}. Click for ${after.label}.`}>
        <span class="sr-only">Theme: </span><span data-label>{theme.label}</span><span class="sr-only" data-next>, switch to {after.label}</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--dim);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    min-height: 3.75rem;
    flex-wrap: wrap;
    padding-block: 0.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--red);
    font-family: var(--font-ui);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .brand__mark {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
  }
  .brand:hover {
    color: var(--red);
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    display: inline-block;
    padding: 0.15rem 0.35rem;
    color: var(--text-dim);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-decoration: none;
  }
  .site-nav a:hover {
    background: var(--select);
    color: var(--accent-text);
  }
  .toggles {
    display: flex;
    gap: 0.5rem;
  }
  @media (max-width: 52rem) {
    .site-nav {
      order: 3;
      width: 100%;
      margin-left: 0;
    }
    .toggles {
      margin-left: auto;
    }
  }
  @media (max-width: 26rem) {
    .brand__word {
      display: none;
    }
  }
</style>
