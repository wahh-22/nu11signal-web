---
import '../styles/global.css';
import { SITE } from '../config';
import SignalGlitch from '../components/SignalGlitch.astro';
import Boot from '../components/Boot.astro';
import StatusBar from '../components/StatusBar.astro';
import KeysDialog from '../components/KeysDialog.astro';
import Immersive from '../components/Immersive.astro';
import {
  DEFAULT_THEME,
  THEMES,
  THEME_IDS,
  THEME_STORAGE_KEY,
  prePaintThemeScript,
  themeArtCss,
  themeById,
} from '../themes.mjs';

interface Props {
  title?: string;
  description?: string;
  /** For pages like 404: no canonical URL, kept out of search indexes. */
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = noindex ? new URL(base, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);

// The theme cycle's data, from the one theme list (src/themes.mjs).
const themeVars = {
  CYCLE: THEME_IDS,
  DEFAULT: DEFAULT_THEME,
  KEY: THEME_STORAGE_KEY,
  LABELS: Object.fromEntries(THEMES.map((t) => [t.id, t.label])),
  COLORS: Object.fromEntries(THEMES.map((t) => [t.id, t.bg])),
};
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={themeById(DEFAULT_THEME).bg} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.shortTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The NU11SIGNAL logo: a masked head with headphones and LED eyes beside the NU11SIGNAL wordmark" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400;600;700&display=swap"
    />

    <!-- Per-theme artwork (ThemeArt.astro): show the active theme's image. -->
    <style is:inline set:html={themeArtCss()}></style>

    <!-- Apply the saved theme before first paint (src/themes.mjs,
         migrateTheme: renamed ids load under their new id, unknown ones load
         the default; both are rewritten). -->
    <script is:inline set:html={prePaintThemeScript()}></script>
  </head>
  <body>
    <Boot />
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <StatusBar />
    <KeysDialog />

    <!-- Theme toggle: [data-theme-toggle] (and the S key, Immersive.astro).
         The theme button cycles through the themes in src/themes.mjs order
         (BLUESHIFT -> REDSHIFT -> NEON ROSE -> BLUESHIFT; BLUESHIFT is the
         default).
         A manual theme pick dispatches nu11signal:theme-picked on document;
         nu11signal:set-theme (detail: a theme id, or 'next' for the following
         theme in the cycle) switches the theme the same way, saved like a pick
         (the signal glitch uses 'next'). -->
    <script is:inline define:vars={themeVars}>
      (function () {
        var d = document.documentElement;
        function save(key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (e) {}
        }
        function current() {
          var t = d.dataset.theme;
          return CYCLE.indexOf(t) >= 0 ? t : DEFAULT;
        }
        function next(theme) {
          return CYCLE[(CYCLE.indexOf(theme) + 1) % CYCLE.length];
        }
        function sync() {
          var theme = current();
          var after = next(theme);
          document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
            b.setAttribute('data-current', theme);
            b.setAttribute('title', 'Color theme: ' + LABELS[theme] + '. Click for ' + LABELS[after] + '.');
            var l = b.querySelector('[data-label]');
            if (l) l.textContent = LABELS[theme];
            var n = b.querySelector('[data-next]');
            if (n) n.textContent = ', switch to ' + LABELS[after];
          });
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', COLORS[theme]);
        }
        function setTheme(theme) {
          if (theme === 'next') theme = next(current());
          d.dataset.theme = CYCLE.indexOf(theme) >= 0 ? theme : DEFAULT;
          save(KEY, d.dataset.theme);
          sync();
        }
        document.addEventListener('nu11signal:set-theme', function (e) {
          setTheme(e instanceof CustomEvent ? e.detail : '');
        });
        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target : null;
          if (!t) return;
          if (t.closest('[data-theme-toggle]')) {
            setTheme('next');
            document.dispatchEvent(new CustomEvent('nu11signal:theme-picked'));
          }
        });
        sync();
      })();
    </script>
    <SignalGlitch />
    <Immersive />
  </body>
</html>
