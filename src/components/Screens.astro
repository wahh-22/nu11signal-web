---
// The screens section: three recordings of the real app (public/demo,
// encoded from the owner's GIFs). The overview is the main figure; SEARCH and
// the themes-and-quit recording sit below it as two cards. The panes carry
// the titles; the section's heading is for screen readers only. In fit mode
// (global.css) the overview fills one screen and the two cards the next,
// each video scaled to fit the screen's height at 1278:702.
import Pane from './Pane.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const demo = (name: string) => `${base}demo/${name}`;

const recordings: { video: string; title: string; alt: string; caption: string }[] = [
  {
    video: 'search',
    title: 'SEARCH // CATALOG',
    alt: 'SEARCH in action: recent searches, live suggestions while typing, then an artist page with its top songs and albums, and a song playing',
    caption: 'Search the catalog.',
  },
  {
    video: 'themes',
    title: 'THEMES // QUIT',
    alt: 'The SETTINGS panel switching the app between the BLUESHIFT, REDSHIFT and NEON ROSE themes, then quitting: the confirmation prompt and the shutdown',
    caption: 'Switch themes, then quit.',
  },
];
---

<section class="section screens" id="screens" aria-labelledby="screens-title" data-section="SCREENS">
  <h2 class="sr-only" id="screens-title">Screens</h2>

  <div class="fit screens__main">
    <div class="container">
      <Pane title="NOW PLAYING // OVERVIEW" class="screen screen--main">
        <figure>
          <video
            width="1278"
            height="702"
            loop
            muted
            playsinline
            controls
            preload="metadata"
            poster={demo('overview-poster.jpg')}
            aria-label="nu11signal in action: launching from the shell, the boot splash, opening a playlist, playing a song, and the data rain reacting to the music"
            data-demo
          >
            <source src={demo('overview.webm')} type="video/webm" />
            <source src={demo('overview.mp4')} type="video/mp4" />
          </video>
          <figcaption>Launch, open a playlist, play.</figcaption>
        </figure>
      </Pane>
    </div>
  </div>

  <div class="fit screens__pair">
    <div class="container">
      <ul class="recordings">
        {
          recordings.map((rec) => (
            <li>
              <Pane title={rec.title} class="screen">
                <figure>
                  <video
                    width="1278"
                    height="702"
                    loop
                    muted
                    playsinline
                    controls
                    preload="none"
                    poster={demo(`${rec.video}-poster.jpg`)}
                    aria-label={rec.alt}
                    data-demo
                  >
                    <source src={demo(`${rec.video}.webm`)} type="video/webm" />
                    <source src={demo(`${rec.video}.mp4`)} type="video/mp4" />
                  </video>
                  <figcaption>{rec.caption}</figcaption>
                </figure>
              </Pane>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // The demo starts itself unless the visitor prefers reduced motion; it
  // stays paused with its controls then (and without JS). Click, Enter or
  // Space pauses and resumes it.
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLVideoElement>('video[data-demo]').forEach((v) => {
    if (reduce) return;
    v.controls = false;
    v.tabIndex = 0;
    v.title = 'Click to pause or play';
    const toggle = () => (v.paused ? v.play() : v.pause());
    v.addEventListener('click', toggle);
    v.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
    v.play().catch(() => {
      v.controls = true;
    });
  });
</script>

<style>
  .screen {
    padding: 1.6rem 0.9rem 0.9rem;
  }
  .screen figure {
    margin: 0;
  }
  .screen video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    background: var(--ink);
    box-shadow:
      0 0 0 1px var(--dim),
      0 1.25rem 3rem -1.25rem var(--glow);
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
  }
  figcaption::before {
    content: '▶ ';
    color: var(--accent-text);
  }
  .recordings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1.75rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 48rem) {
    .recordings {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Fit mode (global.css): each video gets the screen's height less the
     screen's padding, the pane's padding and border, and the caption, and
     its pane is as wide as that height allows at 1278:702 (never wider than
     the container). */
  @media (min-width: 52.0625rem) and (min-height: 35rem) {
    .screens {
      --video-h: calc(var(--screen-h) - 2 * var(--fit-pad) - 2.5rem - 2px - 2.35rem);
      --pane-w: calc(var(--video-h) * 1278 / 702 + 1.8rem + 2px);
      padding-block: 0;
    }
    .screen--main {
      width: min(100%, var(--pane-w));
      margin-inline: auto;
    }
    .recordings {
      grid-template-columns: repeat(2, minmax(0, var(--pane-w)));
      justify-content: center;
      margin-top: 0;
    }
  }
</style>
