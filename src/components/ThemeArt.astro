---
// The official artwork in public/logo/, one <img> per theme in src/themes.mjs.
// The .theme-art rules (global.css, plus the per-theme ones Base.astro inlines
// from themes.mjs) show only the one matching <html data-theme>, so the artwork
// follows a theme change at once. kind="logo" is the full 1650x520 logo;
// kind="mark" is the 500x500 head mark. Decorative: the images have empty
// alt text, so give the surrounding element the accessible name.
import type { HTMLAttributes } from 'astro/types';
import { THEME_IDS, logoFile } from '../themes.mjs';

interface Props extends HTMLAttributes<'span'> {
  kind: 'logo' | 'mark';
}

const { kind, class: className, ...rest } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const [width, height] = kind === 'logo' ? ['1650', '520'] : ['500', '500'];
---

<span class:list={['theme-art', className]} {...rest}>
  {
    THEME_IDS.map((theme) => (
      <img
        class={`theme-art__img theme-art__img--${theme}`}
        src={`${base}${logoFile(kind, theme)}`}
        alt=""
        width={width}
        height={height}
        decoding="async"
      />
    ))
  }
</span>
