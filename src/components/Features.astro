---
// What it does, kept in step with the app's README. Each card links to its docs page.
import { LINKS } from '../config';

const features = [
  {
    glyph: '♪',
    title: 'Apple Music in the terminal',
    body: 'Plays through a tiny windowless MusicKit helper, not a browser or the Music app.',
    links: [{ href: LINKS.architecture, label: 'Architecture' }],
  },
  {
    glyph: '▤',
    title: 'Your own music files',
    body: 'mp3, flac, ogg and wav play beside Apple Music on macOS, and on their own on Linux.',
    links: [{ href: LINKS.localFiles, label: 'Local files' }],
  },
  {
    glyph: '⌕',
    title: 'Search and browse',
    body: 'Search the catalog, open artists, albums and playlists, love songs and edit playlists.',
    links: [{ href: LINKS.browsing, label: 'Browsing' }],
  },
  {
    glyph: '?',
    title: 'Themes and keys',
    body: 'Five color themes in SETTINGS, BLUESHIFT by default. Keyboard or mouse; ? lists every key.',
    links: [
      { href: LINKS.settings, label: 'Settings' },
      { href: LINKS.keys, label: 'Keys' },
    ],
  },
];
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Features</p>
      <h2 class="section-title" id="features-title">What it does</h2>
    </div>
    <ul class="features">
      {
        features.map((f) => (
          <li class="feature">
            <span class="feature__glyph" aria-hidden="true">
              {f.glyph}
            </span>
            <h3 class="feature__title">{f.title}</h3>
            <p class="feature__body">{f.body}</p>
            <p class="feature__links">
              {f.links.map((l) => (
                <a href={l.href} rel="noopener">
                  {l.label} <span aria-hidden="true">→</span>
                </a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<style>
  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .feature {
    position: relative;
    padding: 1.25rem 1.25rem 1.35rem;
    border: 1px solid var(--dim);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s;
  }
  .feature:hover {
    border-color: var(--deep);
  }
  .feature::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 2.25rem;
    height: 2px;
    background: var(--yellow);
  }
  .feature__glyph {
    display: inline-block;
    min-width: 2.5rem;
    color: var(--cyan);
    font-family: var(--font-ui);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .feature__title {
    margin: 0.6rem 0 0.4rem;
    font-size: 1.0625rem;
    color: var(--red);
  }
  :global(:root:is([data-theme='blueshift'], :not([data-theme]))) .feature__title {
    color: var(--text);
  }
  .feature__body {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.9625rem;
  }
  .feature__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.75rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
  }
  @media (prefers-reduced-motion: reduce) {
    .feature {
      transition: none;
    }
  }
  @media (max-width: 40rem) {
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
