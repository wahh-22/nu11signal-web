---
// The null emblem as crisp SVG, built from the exact grid in the app
// (see src/emblem.ts). The ring and slash read --ring and --slash, so the
// emblem follows the active theme. With `glitch`, two tinted copies tear
// across it now and then (CSS only; off under prefers-reduced-motion or
// when the visitor turns the effects off).
import { EMBLEM_HEIGHT, EMBLEM_WIDTH, emblemRects } from '../emblem';

interface Props {
  /** Rendered width in CSS pixels (the emblem is square). */
  size?: number;
  /** Accessible name; leave empty when the emblem is decorative. */
  label?: string;
  glitch?: boolean;
  class?: string;
}

const { size = 40, label = '', glitch = false, class: className } = Astro.props;
const rects = emblemRects();
const viewBox = `0 0 ${EMBLEM_WIDTH} ${EMBLEM_HEIGHT}`;
const layers = glitch ? ['glitch__main', 'glitch__layer glitch__layer--a', 'glitch__layer glitch__layer--b'] : [''];
---

<span
  class:list={['emblem', { glitch }, className]}
  style={`width:${size}px;height:${size}px`}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  {
    layers.map((layer) => (
      <svg
        class={layer || undefined}
        viewBox={viewBox}
        width={size}
        height={size}
        shape-rendering="crispEdges"
        aria-hidden="true"
        focusable="false"
      >
        {rects.map((r) => (
          <rect x={r.x} y={r.y} width={r.width} height={r.height} class={`emblem-${r.part}`} />
        ))}
      </svg>
    ))
  }
</span>

<style>
  .emblem {
    display: inline-block;
    flex: none;
  }
  .emblem :global(.emblem-ring) {
    fill: var(--ring);
  }
  .emblem :global(.emblem-slash) {
    fill: var(--slash);
  }
</style>
