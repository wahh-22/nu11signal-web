---
// Donation links come from src/config.ts (DONATIONS). An unset URL shows its
// button as "coming soon"; with both unset the section says so.
// In fit mode SUPPORT and the footer close the page as a compact last view
// (no forced height), which ends with the footer on the status line.
import { DONATIONS } from '../config';
import Pane from './Pane.astro';

const buttons = [
  { label: 'Buy me a coffee', glyph: '☕', url: DONATIONS.coffee.trim() },
  { label: 'GitHub Sponsors', glyph: '<3', url: DONATIONS.sponsors.trim() },
];
const anyLive = buttons.some((b) => b.url !== '');
---

<section class="section support" id="support" aria-labelledby="support-title" data-section="SUPPORT">
  <div class="container">
    <div class="section-head">
      <h2 class="section-kicker" id="support-title"><span data-scramble>Support // keep it on air</span></h2>
      <p class="section-lede">
        nu11signal is free and open source.{' '}
        {
          anyLive
            ? 'A coffee or a sponsorship keeps it on air.'
            : 'Donation links are coming soon; a star on GitHub helps too.'
        }
      </p>
    </div>

    <Pane title="DONATE // OPTIONAL" class="support__pane">
    <div class="support__buttons">
      {
        buttons.map((b) =>
          b.url ? (
            <a class="hud-btn hud-btn--primary" href={b.url} rel="noopener">
              <span aria-hidden="true">{b.glyph}</span> {b.label}
            </a>
          ) : (
            <span class="hud-btn" aria-disabled="true">
              <span aria-hidden="true">{b.glyph}</span> {b.label} <span class="soon">· coming soon</span>
            </span>
          ),
        )
      }
    </div>
    </Pane>
  </div>
</section>

<style>
  @media (min-width: 52.0625rem) and (min-height: 35rem) {
    .support {
      padding-block: clamp(1.5rem, 4vh, 3rem);
    }
  }
  .support__pane {
    max-width: 44rem;
    padding: 1.75rem 1.25rem 1.25rem;
  }
  .support__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .soon {
    color: var(--text-dim);
    font-weight: 400;
  }
</style>
