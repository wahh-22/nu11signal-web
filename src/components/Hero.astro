---
import ThemeArt from './ThemeArt.astro';
import Pane from './Pane.astro';
import DataRain from './DataRain.astro';
import { INSTALL_COMMANDS, LINKS, REPO } from '../config';

// The official logo, one file per theme (ThemeArt). The glitch layers repeat
// the stack, tinted, and tear across it now and then.
const layers = ['glitch__main', 'glitch__layer glitch__layer--a', 'glitch__layer glitch__layer--b'];

const releaseBadge = `https://img.shields.io/github/v/release/${REPO}?style=for-the-badge&labelColor=0A0A0A&color=FF5F57&label=latest`;
---

<section class="hero" id="top" aria-labelledby="hero-title" data-section="ON AIR">
  <DataRain />
  <div class="container">
  <Pane title="NU11SIGNAL // ON AIR" class="hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">nu11signal</span>
      <span class="hero__logo glitch" aria-hidden="true">
        {layers.map((layer) => <ThemeArt kind="logo" class={layer} />)}
      </span>
    </h1>

    <p class="hero__tagline">A neon car radio for Apple&nbsp;Music, in your terminal.</p>
    <p class="hero__lede">
      Your playlists on a pseudo FM dial, a now-playing panel, and data rain that plays the music. Apple Music and your
      own music files, without leaving the terminal.
    </p>

    <!--
      Without JavaScript both install lines show, each labeled. With it, the
      platform toggle shows one line at a time and the copy button follows it.
    -->
    <Pane title="INSTALL // HOMEBREW" class="install" role="group" aria-label="Install with Homebrew" data-install>
      <div class="install__tabs" role="group" aria-label="Platform" hidden data-install-tabs>
        <button type="button" class="hud-btn hud-btn--small install__tab" aria-pressed="true" data-platform="macos">
          macOS
        </button>
        <button type="button" class="hud-btn hud-btn--small install__tab" aria-pressed="false" data-platform="linux">
          Linux
        </button>
      </div>
      <div class="install__body">
        <div class="install__lines">
          <div class="install__line" data-platform-line="macos">
            <p class="install__row">
              <span class="install__os">macOS</span>
              <span class="install__prompt" aria-hidden="true">$</span>
              <code class="install__cmd" id="install-cmd-macos" data-copy-key="⌘C">{INSTALL_COMMANDS.macos}</code>
            </p>
            <p class="install__note">macOS 14+, Apple Silicon or Intel.</p>
          </div>
          <div class="install__line" data-platform-line="linux">
            <p class="install__row">
              <span class="install__os">Linux</span>
              <span class="install__prompt" aria-hidden="true">$</span>
              <code class="install__cmd" id="install-cmd-linux" data-copy-key="Ctrl+C">{INSTALL_COMMANDS.linux}</code>
            </p>
            <p class="install__note">x86_64 or ARM64, glibc. Your local music files.</p>
          </div>
        </div>
        <button type="button" class="hud-btn hud-btn--small install__copy" data-copy-target="install-cmd-macos">
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </Pane>

    <div class="hero__actions">
      <a class="hud-btn hud-btn--primary" href={LINKS.repo} rel="noopener">View on GitHub</a>
      <a class="hud-btn" href={LINKS.latestRelease} rel="noopener">Latest release</a>
    </div>

    <ul class="hero__meta">
      <li>
        <a href={LINKS.latestRelease} rel="noopener">
          <img src={releaseBadge} alt="Latest nu11signal release" height="28" loading="lazy" decoding="async" />
        </a>
      </li>
      <li class="chip">macOS 14+</li>
      <li class="chip">Linux</li>
      <li class="chip">MIT</li>
    </ul>
  </Pane>
  </div>
</section>

<script is:inline>
  (function () {
    // Platform toggle: show one install line and point the copy button at it.
    document.querySelectorAll('[data-install]').forEach(function (box) {
      var tabs = box.querySelector('[data-install-tabs]');
      var copy = box.querySelector('[data-copy-target]');
      if (!tabs) return;
      function select(platform) {
        tabs.querySelectorAll('[data-platform]').forEach(function (tab) {
          tab.setAttribute('aria-pressed', String(tab.getAttribute('data-platform') === platform));
        });
        box.querySelectorAll('[data-platform-line]').forEach(function (line) {
          var on = line.getAttribute('data-platform-line') === platform;
          line.hidden = !on;
          if (on && copy) {
            var cmd = line.querySelector('code[id]');
            if (cmd) copy.setAttribute('data-copy-target', cmd.id);
          }
        });
      }
      tabs.addEventListener('click', function (e) {
        var tab = e.target instanceof Element ? e.target.closest('[data-platform]') : null;
        if (tab) select(tab.getAttribute('data-platform') || 'macos');
      });
      var ua = navigator.userAgent || '';
      box.setAttribute('data-js', '');
      tabs.hidden = false;
      select(/Linux/.test(ua) && !/Android/.test(ua) ? 'linux' : 'macos');
    });

    document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        // Read the target on every click: the platform toggle changes it.
        var src = document.getElementById(btn.getAttribute('data-copy-target') || '');
        var label = btn.querySelector('[data-copy-label]');
        var status = btn.closest('[data-install]');
        status = status && status.querySelector('[data-copy-status]');
        if (!src) return;
        var text = src.textContent || '';
        var key = src.getAttribute('data-copy-key') || 'Ctrl+C';
        function done(ok) {
          if (label) label.textContent = ok ? 'Copied ✓' : 'Press ' + key;
          if (status) status.textContent = ok ? 'Install command copied to the clipboard.' : 'Copy failed; select the command and copy it.';
          if (!ok) {
            var r = document.createRange();
            r.selectNodeContents(src);
            var s = window.getSelection();
            if (s) {
              s.removeAllRanges();
              s.addRange(r);
            }
          }
          setTimeout(function () {
            if (label) label.textContent = 'Copy';
          }, 2000);
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(
            function () {
              done(true);
            },
            function () {
              done(false);
            },
          );
        } else {
          done(false);
        }
      });
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(2.25rem, 6vw, 4rem) 0 clamp(2.5rem, 6vw, 4rem);
    /* The glitch layers shift sideways; never let them widen the page. */
    overflow-x: clip;
    isolation: isolate;
  }
  /* The pane lets the rain show through, dimmed, so the text stays clear. */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem) clamp(1.75rem, 4vw, 2.5rem);
    background: color-mix(in srgb, var(--bg) 58%, transparent);
  }
  .hero__title {
    width: 100%;
    margin: 0;
    line-height: 0;
  }
  /* 1650 x 520 artwork: about 300 x 95 at a 360px phone, 46rem at most. */
  .hero__logo {
    display: block;
    width: min(100%, 46rem);
    aspect-ratio: 1650 / 520;
  }
  .hero__tagline {
    margin: 1.75rem 0 0;
    font-size: clamp(1.05rem, 2.6vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--cyan);
  }
  .hero__lede {
    max-width: 44rem;
    margin: 0.75rem 0 0;
    color: var(--text-dim);
  }
  .install {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 44rem;
    margin-top: 2.25rem;
    padding: 1.5rem 1rem 1rem;
    background: var(--surface);
  }
  .install__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .install__tabs[hidden] {
    display: none;
  }
  /* The selected platform reads like a primary HUD button (white ink on BLUESHIFT). */
  .install__tab[aria-pressed='true'] {
    border-color: var(--yellow);
    background: var(--yellow);
    color: var(--install-tab-ink, var(--ink));
  }
  .install__tab[aria-pressed='true']::before,
  .install__tab[aria-pressed='true']::after {
    color: inherit;
  }
  :root:is([data-theme='blueshift'], :not([data-theme])) .install {
    --install-tab-ink: #fff;
  }
  .install__tab[aria-pressed='false'] {
    color: var(--text-dim);
  }
  .install__tab[aria-pressed='false']:hover {
    color: var(--accent-text);
  }
  .install__body {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .install__lines {
    display: flex;
    flex: 1 1 16rem;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .install__line[hidden] {
    display: none;
  }
  .install__row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    min-height: 2.25rem;
    padding-top: 0.4rem;
  }
  .install__os {
    flex: none;
    min-width: 3.5rem;
    color: var(--cyan);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }
  /* The toggle names the platform once JavaScript runs. */
  [data-js] .install__os {
    display: none;
  }
  .install__prompt {
    color: var(--accent-text);
  }
  .install__cmd {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--text);
    font-size: 0.95rem;
  }
  .install__note {
    margin: 0.25rem 0 0;
    color: var(--text-dim);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .install__note code {
    overflow-wrap: anywhere;
    color: var(--text);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero__meta img {
    height: 28px;
    width: auto;
  }
  .chip {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--muted);
    border-radius: 2px;
    color: var(--text-dim);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .chip::before {
    content: '▮ ';
    color: var(--accent-text);
  }
</style>
