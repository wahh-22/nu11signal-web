---
// What it does, kept in step with the app's README. Each card links to its docs page.
// In fit mode (global.css) FEATURES and INSTALL share one screen (index.astro's
// .duo): the cards take the room INSTALL leaves, their two rows stretch to
// fill it, and spacing and type grow with the window's height.
import { LINKS } from '../config';
import Pane from './Pane.astro';

const features = [
  {
    glyph: '♪',
    title: 'Apple Music in the terminal',
    body: 'Plays through a tiny windowless MusicKit helper, not a browser or the Music app.',
    links: [{ href: LINKS.architecture, label: 'Architecture' }],
  },
  {
    glyph: '▤',
    title: 'Your own music files',
    body: 'mp3, flac, ogg and wav play beside Apple Music on macOS, and on their own on Linux.',
    links: [{ href: LINKS.localFiles, label: 'Local files' }],
  },
  {
    glyph: '⌕',
    title: 'Search and browse',
    body: 'Search the catalog, open artists, albums and playlists, love songs and edit playlists.',
    links: [{ href: LINKS.browsing, label: 'Browsing' }],
  },
  {
    glyph: '?',
    title: 'Themes and keys',
    body: 'Five color themes in SETTINGS, BLUESHIFT by default. Keyboard or mouse; ? lists every key.',
    links: [
      { href: LINKS.settings, label: 'Settings' },
      { href: LINKS.keys, label: 'Keys' },
    ],
  },
];
---

<section class="section features-sec" id="features" aria-labelledby="features-title" data-section="FEATURES">
  <div class="container">
    <div class="section-head">
      <h2 class="section-kicker" id="features-title"><span data-scramble>Features</span></h2>
    </div>
    <ul class="features">
      {
        features.map((f) => (
          <li>
            <Pane title={f.title} tag="h3" class="feature">
            <span class="feature__glyph" aria-hidden="true">
              {f.glyph}
            </span>
            <p class="feature__body">{f.body}</p>
            <p class="feature__links">
              {f.links.map((l) => (
                <a href={l.href} rel="noopener">
                  {l.label} <span aria-hidden="true">→</span>
                </a>
              ))}
            </p>
            </Pane>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<style>
  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features > li {
    display: flex;
  }
  /* Glyph on the left; the text, then the links pinned to the card's foot. */
  .feature {
    flex: 1;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'glyph body'
      'glyph links';
    gap: 0.25rem 1rem;
    padding: 1.6rem 1.25rem 1.25rem;
  }
  .feature__glyph {
    grid-area: glyph;
    align-self: start;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--dim);
    color: var(--cyan);
    font-size: 1.15rem;
    font-weight: 700;
  }
  .feature__body {
    grid-area: body;
    margin: 0;
    color: var(--text-dim);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .feature__links {
    grid-area: links;
    align-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
  }
  @media (max-width: 40rem) {
    .features {
      grid-template-columns: 1fr;
    }
  }

  /* Fit mode: the section grows into the screen's free height (a flex
     chain down to the grid, whose two rows share it), and lands with the
     screen's top padding above it, so a jump shows the whole screen. */
  @media (min-width: 52.0625rem) and (min-height: 35rem) {
    .features-sec {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      padding-block: 0;
      scroll-margin-top: var(--fit-pad);
    }
    .features-sec > .container {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      width: 100%;
    }
    .features {
      flex: 1 1 auto;
      grid-auto-rows: 1fr;
      gap: clamp(0.75rem, 2.4vh, 2rem) clamp(1rem, 2vw, 1.75rem);
    }
    .feature {
      column-gap: clamp(1rem, 1.6vw, 1.5rem);
      padding: clamp(1.35rem, 3.6vh, 2.75rem) clamp(1.1rem, 2vw, 2rem) clamp(0.8rem, 2.6vh, 2rem);
    }
    .feature__glyph {
      width: clamp(2.25rem, 6.5vh, 4rem);
      height: clamp(2.25rem, 6.5vh, 4rem);
      font-size: clamp(1rem, 2.6vh, 1.75rem);
    }
    .feature__body {
      font-size: clamp(0.8125rem, 0.35rem + 1.15vh, 1.125rem);
      line-height: 1.65;
    }
    .feature__links {
      font-size: clamp(0.75rem, 0.3rem + 1vh, 1rem);
    }
  }
  /* Short windows (up to 720px tall): the glyphs step aside, so each text
     runs full width in fewer lines and INSTALL keeps its room. */
  @media (min-width: 52.0625rem) and (min-height: 35rem) and (max-height: 45rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'body'
        'links';
    }
    .feature__glyph {
      display: none;
    }
    .feature {
      padding-block: clamp(1.25rem, 3.4vh, 1.6rem) clamp(0.7rem, 2vh, 1rem);
    }
    .feature__body {
      line-height: 1.55;
    }
    .feature__links {
      margin-top: 0.35rem;
    }
  }
</style>
