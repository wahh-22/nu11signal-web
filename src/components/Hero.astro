---
import ThemeArt from './ThemeArt.astro';
import Pane from './Pane.astro';
import DataRain from './DataRain.astro';
import { INSTALL_COMMANDS, LINKS, REPO } from '../config';
import { releaseBadgeScript } from '../release.mjs';

// The official logo, one file per theme (ThemeArt). The glitch layers repeat
// the stack, tinted, and tear across it now and then.
const layers = ['glitch__main', 'glitch__layer glitch__layer--a', 'glitch__layer glitch__layer--b'];

// The latest-release badge: a plain link until the inline script (release.mjs)
// fills in the current tag, so a new release shows without a redeploy.
const releaseScript = releaseBadgeScript(`https://api.github.com/repos/${REPO}/releases/latest`, `${LINKS.releases}/tag/`);
---

<section class="hero fit" id="top" aria-labelledby="hero-title" data-section="ON AIR">
  <DataRain />
  <div class="container">
  <Pane title="NU11SIGNAL // ON AIR" class="hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">nu11signal</span>
      <span class="hero__logo glitch" aria-hidden="true">
        {layers.map((layer) => <ThemeArt kind="logo" class={layer} />)}
      </span>
    </h1>

    <p class="hero__tagline">A terminal-native music player for Apple&nbsp;Music and local files.</p>
    <p class="hero__lede">
      Built for the terminal: instant search, keyboard and mouse control, and beautiful visuals. Browse and play
      without leaving your shell.
    </p>

    <!--
      Without JavaScript both install lines show, each labeled. With it, the
      platform toggle shows one line at a time and the copy button follows it.
    -->
    <Pane title="INSTALL // HOMEBREW" class="install" role="group" aria-label="Install with Homebrew" data-install>
      <div class="install__tabs" role="group" aria-label="Platform" hidden data-install-tabs>
        <button type="button" class="hud-btn hud-btn--small install__tab" aria-pressed="true" data-platform="macos">
          macOS
        </button>
        <button type="button" class="hud-btn hud-btn--small install__tab" aria-pressed="false" data-platform="linux">
          Linux
        </button>
      </div>
      <div class="install__body">
        <div class="install__lines">
          <div class="install__line" data-platform-line="macos">
            <p class="install__row">
              <span class="install__os">macOS</span>
              <span class="install__prompt" aria-hidden="true">$</span>
              <code class="install__cmd" id="install-cmd-macos" data-copy-key="⌘C">{INSTALL_COMMANDS.macos}</code>
            </p>
            <p class="install__note">macOS 14+, Apple Silicon or Intel.</p>
          </div>
          <div class="install__line" data-platform-line="linux">
            <p class="install__row">
              <span class="install__os">Linux</span>
              <span class="install__prompt" aria-hidden="true">$</span>
              <code class="install__cmd" id="install-cmd-linux" data-copy-key="Ctrl+C">{INSTALL_COMMANDS.linux}</code>
            </p>
            <p class="install__note">x86_64 or ARM64, glibc. Your local music files.</p>
          </div>
        </div>
        <button type="button" class="hud-btn hud-btn--small install__copy" data-copy-target="install-cmd-macos">
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </Pane>

    <div class="hero__actions">
      <a class="hud-btn hud-btn--primary" href={LINKS.repo} rel="noopener">View on GitHub</a>
      <a class="hud-btn" href={LINKS.latestRelease} rel="noopener">Latest release</a>
    </div>

    <ul class="hero__meta">
      <li>
        <a class="release-badge" href={LINKS.latestRelease} rel="noopener" data-release-badge>
          <span class="release-badge__label">Latest</span><span class="release-badge__value" data-release-version>release</span>
        </a>
      </li>
      <li class="chip">macOS 14+</li>
      <li class="chip">Linux</li>
      <li class="chip">MIT</li>
    </ul>
  </Pane>
  </div>
</section>

<script is:inline set:html={releaseScript} />

<script is:inline>
  (function () {
    // Platform toggle: show one install line and point the copy button at it.
    document.querySelectorAll('[data-install]').forEach(function (box) {
      var tabs = box.querySelector('[data-install-tabs]');
      var copy = box.querySelector('[data-copy-target]');
      if (!tabs) return;
      function select(platform) {
        tabs.querySelectorAll('[data-platform]').forEach(function (tab) {
          tab.setAttribute('aria-pressed', String(tab.getAttribute('data-platform') === platform));
        });
        box.querySelectorAll('[data-platform-line]').forEach(function (line) {
          var on = line.getAttribute('data-platform-line') === platform;
          line.hidden = !on;
          if (on && copy) {
            var cmd = line.querySelector('code[id]');
            if (cmd) copy.setAttribute('data-copy-target', cmd.id);
          }
        });
      }
      tabs.addEventListener('click', function (e) {
        var tab = e.target instanceof Element ? e.target.closest('[data-platform]') : null;
        if (tab) select(tab.getAttribute('data-platform') || 'macos');
      });
      var ua = navigator.userAgent || '';
      box.setAttribute('data-js', '');
      tabs.hidden = false;
      select(/Linux/.test(ua) && !/Android/.test(ua) ? 'linux' : 'macos');
    });

    document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        // Read the target on every click: the platform toggle changes it.
        var src = document.getElementById(btn.getAttribute('data-copy-target') || '');
        var label = btn.querySelector('[data-copy-label]');
        var status = btn.closest('[data-install]');
        status = status && status.querySelector('[data-copy-status]');
        if (!src) return;
        var text = src.textContent || '';
        var key = src.getAttribute('data-copy-key') || 'Ctrl+C';
        function done(ok) {
          if (label) label.textContent = ok ? 'Copied ✓' : 'Press ' + key;
          if (status) status.textContent = ok ? 'Install command copied to the clipboard.' : 'Copy failed; select the command and copy it.';
          if (!ok) {
            var r = document.createRange();
            r.selectNodeContents(src);
            var s = window.getSelection();
            if (s) {
              s.removeAllRanges();
              s.addRange(r);
            }
          }
          setTimeout(function () {
            if (label) label.textContent = 'Copy';
          }, 2000);
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(
            function () {
              done(true);
            },
            function () {
              done(false);
            },
          );
        } else {
          done(false);
        }
      });
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(2.25rem, 6vw, 4rem) 0 clamp(2.5rem, 6vw, 4rem);
    /* The glitch layers shift sideways; never let them widen the page. */
    overflow-x: clip;
    isolation: isolate;
  }
  /* The pane lets the rain show through, dimmed, so the text stays clear. */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem) clamp(1.75rem, 4vw, 2.5rem);
    background: color-mix(in srgb, var(--bg) 58%, transparent);
  }
  .hero__title {
    width: 100%;
    margin: 0;
    line-height: 0;
  }
  /* 1650 x 520 artwork: about 300 x 95 at a 360px phone, 46rem at most. */
  .hero__logo {
    display: block;
    width: min(100%, 46rem);
    aspect-ratio: 1650 / 520;
  }
  .hero__tagline {
    margin: 1.75rem 0 0;
    font-size: clamp(1.05rem, 2.6vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--cyan);
  }
  .hero__lede {
    max-width: 44rem;
    margin: 0.75rem 0 0;
    color: var(--text-dim);
  }
  .install {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 44rem;
    margin-top: 2.25rem;
    padding: 1.5rem 1rem 1rem;
    background: var(--surface);
  }
  .install__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .install__tabs[hidden] {
    display: none;
  }
  /* The selected platform reads like a primary HUD button (--on-accent ink). */
  .install__tab[aria-pressed='true'] {
    border-color: var(--yellow);
    background: var(--yellow);
    color: var(--on-accent);
  }
  .install__tab[aria-pressed='true']::before,
  .install__tab[aria-pressed='true']::after {
    color: inherit;
  }
  .install__tab[aria-pressed='false'] {
    color: var(--text-dim);
  }
  .install__tab[aria-pressed='false']:hover {
    color: var(--accent-text);
  }
  .install__body {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .install__lines {
    display: flex;
    flex: 1 1 16rem;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .install__line[hidden] {
    display: none;
  }
  .install__row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    min-height: 2.25rem;
    padding-top: 0.4rem;
  }
  .install__os {
    flex: none;
    min-width: 3.5rem;
    color: var(--cyan);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }
  /* The toggle names the platform once JavaScript runs. */
  [data-js] .install__os {
    display: none;
  }
  .install__prompt {
    color: var(--accent-text);
  }
  .install__cmd {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--text);
    font-size: 0.95rem;
  }
  .install__note {
    margin: 0.25rem 0 0;
    color: var(--text-dim);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .install__note code {
    overflow-wrap: anywhere;
    color: var(--text);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* The latest-release badge: a two-part HUD tag in the theme's colors, the
     label filled with the active color. The value keeps room for the longest
     tag it may show (9 characters), so filling in the version shifts nothing. */
  .release-badge {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--yellow);
    border-radius: 2px;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .release-badge__label {
    padding: 0.15rem 0.5rem;
    background: var(--yellow);
    color: var(--on-accent);
    font-weight: 700;
  }
  .release-badge__label::before {
    content: '▮ ';
  }
  .release-badge__value {
    min-width: calc(9ch + 0.9em);
    padding: 0.15rem 0.5rem;
    color: var(--accent-text);
  }
  .release-badge:hover .release-badge__value,
  .release-badge:focus-visible .release-badge__value {
    background: var(--select);
    color: var(--text);
  }
  .chip {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--muted);
    border-radius: 2px;
    color: var(--text-dim);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .chip::before {
    content: '▮ ';
    color: var(--accent-text);
  }

  /* Fit mode (global.css): the hero is exactly one screen. The section, its
     container and the pane shrink as a flex chain, and the logo absorbs the
     shortfall (it scales between 2.5rem and its full 46rem width), so the
     install box, the buttons and the chips always stay in view. Spacing
     tightens with the window's height. */
  @media (min-width: 52.0625rem) and (min-height: 35rem) {
    .hero {
      height: var(--screen-h);
      min-height: 0;
      padding-block: var(--fit-pad);
    }
    .hero > .container {
      display: flex;
      flex-direction: column;
      flex: 0 1 auto;
      min-height: 0;
    }
    .hero__inner {
      flex: 0 1 auto;
      min-height: 0;
      padding-block: clamp(1.25rem, 3.5vh, 3rem) clamp(1rem, 3vh, 2.5rem);
    }
    .hero__title {
      display: flex;
      flex: 0 1 auto;
      height: min(14.5rem, 30vh);
      min-height: 2.5rem;
    }
    .hero__logo {
      aspect-ratio: auto;
    }
    .hero__logo :global(.theme-art__img) {
      object-position: left center;
    }
    .hero__tagline {
      margin-top: clamp(0.5rem, 2.5vh, 1.75rem);
    }
    .hero__lede {
      margin-top: clamp(0.25rem, 1.2vh, 0.75rem);
    }
    .install {
      margin-top: clamp(1rem, 3vh, 2.25rem);
      gap: clamp(0.4rem, 1.2vh, 0.75rem);
      padding-block: clamp(1.1rem, 2.5vh, 1.5rem) clamp(0.6rem, 1.5vh, 1rem);
    }
    .hero__actions {
      margin-top: clamp(0.6rem, 2.2vh, 1.5rem);
    }
    .hero__meta {
      margin-top: clamp(0.6rem, 2.2vh, 1.75rem);
    }
    /* A wider lede wraps to fewer lines, leaving the logo more room. */
    .hero__lede {
      max-width: 56rem;
    }
  }
  /* Short windows (up to 720px tall): smaller text and controls, so the
     logo keeps a readable size. */
  @media (min-width: 52.0625rem) and (min-height: 35rem) and (max-height: 45rem) {
    .hero__tagline {
      font-size: 1.1rem;
    }
    .hero__lede {
      font-size: 0.875rem;
      line-height: 1.55;
    }
    .install__row {
      min-height: 2rem;
      padding-top: 0.2rem;
    }
    .install__note {
      margin-top: 0;
    }
    .hero__actions .hud-btn {
      min-height: 2.4rem;
      padding-block: 0.4rem;
    }
  }
</style>
