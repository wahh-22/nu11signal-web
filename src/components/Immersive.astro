---
// The page's terminal behavior, all progressive: without JavaScript none of
// it runs and the content reads as usual.
//
// - Status line (StatusBar.astro): the section in view (the last of main's
//   [data-section] elements whose top has passed a line a third of the way
//   down the viewport, and the last one at the page's end), a node id
//   per session, a live HH:MM:SS clock and the theme name.
// - Keys: ? opens the KEYS dialog (KeysDialog.astro), S cycles the theme
//   (like the theme button), 1-4 jump to the top, SCREENS, FEATURES (the
//   screen it shares with INSTALL) and SUPPORT (the page's end). Ignored while focus is in anything editable (fields, content-
//   editable, ARIA text boxes), while the boot runs, on key repeat, and with
//   Ctrl, Alt or Cmd held, so browser shortcuts stay untouched. The KEYS
//   dialog's SHORTCUTS button turns them all off (WCAG 2.1.4), saved per
//   browser as nu11signal:shortcuts = 'off'.
// - Scramble-in: every [data-scramble] title resolves from glyphs to its
//   text, left to right in about 0.9 s, once, when it first scrolls into
//   view (like the app's content intros). Only text nodes change, so each
//   character keeps its color; screen readers read a hidden copy of the real
//   text while it runs. It waits for the boot to end, and never runs with
//   prefers-reduced-motion.
// - Screen size: keeps --header-h (global.css) equal to the header's real
//   height, so fit mode's screens (each one between the header and the
//   status line) and the 1-4 jumps land exactly. Without JavaScript the CSS
//   default applies.
---

<script>
  import { DEFAULT_THEME, themeById } from '../themes.mjs';

  const d = document.documentElement;
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const JUMPS: Record<string, string> = { '1': 'top', '2': 'screens', '3': 'features', '4': 'support' };

  // ---- screen size -----------------------------------------------------------

  const measured: [string, string][] = [['.site-header', '--header-h']];
  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver(() => {
      for (const [sel, prop] of measured) {
        const el = document.querySelector<HTMLElement>(sel);
        if (el) d.style.setProperty(prop, `${el.getBoundingClientRect().height}px`);
      }
    });
    measured.forEach(([sel]) => {
      const el = document.querySelector(sel);
      if (el) ro.observe(el);
    });
  }

  // ---- status line ---------------------------------------------------------

  document.querySelectorAll<HTMLElement>('[data-status-js]').forEach((el) => (el.hidden = false));

  const themeName = document.querySelector<HTMLElement>('[data-status-theme-name]');
  const syncTheme = () => {
    if (themeName) themeName.textContent = themeById(d.dataset.theme || DEFAULT_THEME).label;
  };
  syncTheme();
  new MutationObserver(syncTheme).observe(d, { attributes: true, attributeFilter: ['data-theme'] });

  const node = document.querySelector<HTMLElement>('[data-status-node]');
  if (node) {
    let id = '';
    try {
      id = sessionStorage.getItem('nu11signal:node') || '';
    } catch {}
    if (!/^[0-9A-F]{4}$/.test(id)) {
      id = Math.floor(Math.random() * 0x10000)
        .toString(16)
        .toUpperCase()
        .padStart(4, '0');
      try {
        sessionStorage.setItem('nu11signal:node', id);
      } catch {}
    }
    node.textContent = id;
  }

  const clock = document.querySelector<HTMLElement>('[data-status-clock]');
  if (clock) {
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const t = new Date();
      clock.textContent = `${pad(t.getHours())}:${pad(t.getMinutes())}:${pad(t.getSeconds())}`;
      setTimeout(tick, 1000 - (Date.now() % 1000) + 5);
    };
    tick();
  }

  const sectionLabel = document.querySelector<HTMLElement>('[data-status-section]');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));
  if (sectionLabel && sections.length) {
    // The last section whose top has passed a line 35% down the viewport;
    // at the page's end, where the short last sections share the view, the
    // last one.
    let queued = false;
    const syncSection = () => {
      queued = false;
      const se = document.scrollingElement || d;
      const atEnd = window.scrollY + window.innerHeight >= se.scrollHeight - 2;
      const line = window.innerHeight * 0.35;
      let current = sections[0];
      if (atEnd) current = sections[sections.length - 1];
      else for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
      const label = current.dataset.section || '';
      if (sectionLabel.textContent !== label) sectionLabel.textContent = label;
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(syncSection);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    syncSection();
  }

  // ---- theme and keys --------------------------------------------------------

  const nextTheme = () => {
    document.dispatchEvent(new CustomEvent('nu11signal:set-theme', { detail: 'next' }));
    document.dispatchEvent(new CustomEvent('nu11signal:theme-picked'));
  };
  document.querySelector('[data-status-theme]')?.addEventListener('click', nextTheme);

  const dialog = document.querySelector<HTMLDialogElement>('dialog[data-keys]');
  let opener: HTMLElement | null = null;
  const openKeys = () => {
    if (!dialog || dialog.open) return;
    opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    dialog.showModal();
    dialog.querySelector<HTMLElement>('[data-keys-close]')?.focus();
  };
  dialog?.addEventListener('close', () => {
    if (opener && opener.isConnected) opener.focus({ preventScroll: true });
    opener = null;
  });
  // A click on the backdrop (outside the dialog's box) closes it too.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      const r = dialog.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dialog.close();
    }
  });
  document.querySelector('[data-keys-open]')?.addEventListener('click', openKeys);

  const jump = (id: string) => {
    const target = document.getElementById(id);
    if (!target) {
      // Not on this page (the 404 page): go to the home page's section.
      const base = dialog?.dataset.base || '/';
      window.location.href = id === 'top' ? base : `${base}#${id}`;
      return;
    }
    target.scrollIntoView({ behavior: motion.matches ? 'auto' : 'smooth', block: 'start' });
    // Move keyboard focus with the view, without a second scroll.
    if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
    target.focus({ preventScroll: true });
    if (id !== 'top') history.replaceState(null, '', `#${id}`);
    else history.replaceState(null, '', window.location.pathname + window.location.search);
  };

  const EDITABLE = 'input, textarea, select, [contenteditable]:not([contenteditable="false"]), [role="textbox"], [role="searchbox"], [role="combobox"], [role="spinbutton"]';
  const typing = (t: EventTarget | null) =>
    t instanceof Element && ((t instanceof HTMLElement && t.isContentEditable) || !!t.closest(EDITABLE));

  // The off switch for the single-key shortcuts.
  const SHORTCUTS_KEY = 'nu11signal:shortcuts';
  let shortcutsOn = true;
  try {
    shortcutsOn = localStorage.getItem(SHORTCUTS_KEY) !== 'off';
  } catch {}
  const toggle = document.querySelector<HTMLButtonElement>('[data-shortcuts-toggle]');
  const syncShortcuts = () => {
    if (!toggle) return;
    toggle.setAttribute('aria-pressed', String(shortcutsOn));
    const label = toggle.querySelector('[data-label]');
    if (label) label.textContent = shortcutsOn ? 'On' : 'Off';
  };
  toggle?.addEventListener('click', () => {
    shortcutsOn = !shortcutsOn;
    try {
      if (shortcutsOn) localStorage.removeItem(SHORTCUTS_KEY);
      else localStorage.setItem(SHORTCUTS_KEY, 'off');
    } catch {}
    syncShortcuts();
  });
  syncShortcuts();

  document.addEventListener('keydown', (e) => {
    if (!shortcutsOn || e.defaultPrevented || e.repeat || e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
    if (typing(e.target) || d.hasAttribute('data-booting')) return;
    if (e.key === '?') {
      e.preventDefault();
      if (dialog?.open) dialog.close();
      else openKeys();
      return;
    }
    if (dialog?.open) return;
    if (e.key === 's' || e.key === 'S') {
      e.preventDefault();
      nextTheme();
    } else if (!e.shiftKey && JUMPS[e.key]) {
      e.preventDefault();
      jump(JUMPS[e.key]);
    }
  });

  // ---- scramble-in titles ------------------------------------------------------

  // Glyphs Kode Mono draws at one cell, so a title keeps its width.
  const GLYPHS = '0123456789ABCDEF#%&*+=<>/\\|:$@';
  const DURATION = 900;
  const FRAME = 40;

  // A small seeded generator: each title scrambles the same way every time.
  const seeded = (seed: number) => () => {
    seed = (seed * 1664525 + 1013904223) >>> 0;
    return seed / 0x100000000;
  };

  const scramble = (el: HTMLElement) => {
    const texts: { node: Text; text: string }[] = [];
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    for (let n = walker.nextNode(); n; n = walker.nextNode()) texts.push({ node: n as Text, text: n.nodeValue || '' });
    const full = texts.map((t) => t.text).join('');
    const total = full.length;
    if (!total) return;
    let seed = 0;
    for (let i = 0; i < total; i++) seed = (seed * 31 + full.charCodeAt(i)) >>> 0;
    // Screen readers read a hidden copy of the real text while it runs.
    const copy = document.createElement('span');
    copy.className = 'sr-only';
    copy.textContent = full;
    el.after(copy);
    el.setAttribute('aria-hidden', 'true');
    const start = performance.now();
    const step = () => {
      const p = Math.min((performance.now() - start) / DURATION, 1);
      const resolved = Math.floor(p * total);
      const rand = seeded(seed + Math.floor((performance.now() - start) / FRAME));
      let at = 0;
      for (const t of texts) {
        let out = '';
        for (const ch of t.text) {
          out += at < resolved || /\s/.test(ch) ? ch : GLYPHS.charAt(Math.floor(rand() * GLYPHS.length));
          at++;
        }
        t.node.nodeValue = out;
      }
      if (p < 1) setTimeout(step, FRAME);
      else {
        texts.forEach((t) => (t.node.nodeValue = t.text));
        el.removeAttribute('aria-hidden');
        copy.remove();
      }
    };
    step();
  };

  const observeTitles = () => {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        scramble(e.target as HTMLElement);
      }
    });
    document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => io.observe(el));
  };
  if (!motion.matches && 'IntersectionObserver' in window) {
    // Titles behind the boot wait for it to end (Boot.astro).
    if (d.hasAttribute('data-booting')) document.addEventListener('nu11signal:boot-end', observeTitles, { once: true });
    else observeTitles();
  }
</script>
