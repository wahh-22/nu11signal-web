---
// The screens section: a recording of the real app on top, then the app's
// own 80x24 screen renders (copied from the app repo's docs/assets/screens).
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = (name: string) => `${base}screens/${name}.svg`;

const demo = (name: string) => `${base}demo/${name}`;

const gallery = [
  {
    name: 'search',
    title: 'SEARCH',
    alt: 'SEARCH with live suggestions, matching artists and songs',
    caption: 'Live suggestions, recent searches, artists, albums, songs and playlists.',
  },
  {
    name: 'expanded',
    title: 'Expanded player',
    alt: 'The expanded player with the data rain under the transport controls',
    caption: 'f expands NOW PLAYING to the full width, rain and all.',
  },
  {
    name: 'no-signal',
    title: 'Signal effects',
    alt: 'A glitch burst tearing rows and flashing NO SIGNAL over the UI',
    caption: 'Torn rows, corrupted cells, static bars, and now and then NO SIGNAL.',
  },
  {
    name: 'keys',
    title: 'KEYS',
    alt: 'The KEYS overlay listing every binding by group',
    caption: '? opens every binding in one panel.',
  },
  {
    name: 'settings',
    title: 'SETTINGS',
    alt: 'The SETTINGS panel offering the BLUESHIFT, REDSHIFT, MATRIX, ROSE and NEON ROSE themes',
    caption: 's opens the themes: BLUESHIFT, REDSHIFT, MATRIX, ROSE or NEON ROSE; the choice is saved.',
  },
  {
    name: 'boot',
    title: 'Boot splash',
    alt: 'The boot splash: the logo over BOOTING NU11SIGNAL',
    caption: 'The app boots and shuts down over the logo.',
  },
];
---

<section class="section" id="screens" aria-labelledby="screens-title">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Signal acquired</p>
      <h2 class="section-title" id="screens-title">The radio, in 80×24</h2>
      <p class="section-lede">
        Playlists on the dial at the left, NOW PLAYING with bracketed transport controls and data rain at the right.
        Recorded from the real app.
      </p>
    </div>

    <figure class="terminal">
      <video
        class="terminal__img"
        width="1278"
        height="702"
        loop
        muted
        playsinline
        controls
        preload="metadata"
        poster={demo('overview-poster.jpg')}
        aria-label="nu11signal in action: launching from the shell, the boot splash, opening a playlist, playing a song, and the data rain reacting to the music"
        data-demo
      >
        <source src={demo('overview.webm')} type="video/webm" />
        <source src={demo('overview.mp4')} type="video/mp4" />
      </video>
      <figcaption>Launch, open a playlist, play: the rain follows the music.</figcaption>
    </figure>

    <ul class="gallery">
      {
        gallery.map((shot) => (
          <li>
            <figure>
              <img src={src(shot.name)} width="840" height="556" alt={shot.alt} loading="lazy" decoding="async" />
              <figcaption>
                <strong>{shot.title}</strong> — {shot.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // The demo starts itself unless the visitor prefers reduced motion; it
  // stays paused with its controls then (and without JS). Click, Enter or
  // Space pauses and resumes it.
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLVideoElement>('video[data-demo]').forEach((v) => {
    if (reduce) return;
    v.controls = false;
    v.tabIndex = 0;
    v.title = 'Click to pause or play';
    const toggle = () => (v.paused ? v.play() : v.pause());
    v.addEventListener('click', toggle);
    v.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
    v.play().catch(() => {
      v.controls = true;
    });
  });
</script>

<style>
  .terminal {
    margin: 0;
  }
  .terminal__img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px var(--dim),
      0 1.5rem 4rem -1rem var(--glow);
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 0.9375rem;
  }
  figcaption strong {
    color: var(--text);
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.75rem 1.5rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .gallery figure {
    margin: 0;
  }
  .gallery img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--dim);
  }
</style>
