---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeArt from '../components/ThemeArt.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// The head mark for the active theme, with the same glitch layers as the hero.
const layers = ['glitch__main', 'glitch__layer glitch__layer--a', 'glitch__layer glitch__layer--b'];
---

<Base title="NO SIGNAL — nu11signal" description="This page lost the signal." noindex>
  <Header />
  <main id="main" class="lost" data-section="NO SIGNAL">
    <div class="container lost__inner">
      <span class="lost__mark glitch" aria-hidden="true">
        {layers.map((layer) => <ThemeArt kind="mark" class={layer} />)}
      </span>
      <h1>NO SIGNAL</h1>
      <p>Error 404: this frequency is empty.</p>
      <a class="hud-btn hud-btn--primary" href={base}>Back to the dial</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .lost {
    min-height: 60vh;
    display: grid;
    place-items: center;
    padding: 4rem 0;
    /* The glitch layers shift sideways; never let them widen the page. */
    overflow-x: clip;
  }
  .lost__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }
  .lost__mark {
    display: block;
    width: 8rem;
    height: 8rem;
  }
  h1 {
    margin: 0.5rem 0 0;
    color: var(--red);
    font-size: clamp(2rem, 8vw, 3.5rem);
    letter-spacing: 0.15em;
  }
  p {
    margin: 0 0 1rem;
    color: var(--text-dim);
  }
</style>
