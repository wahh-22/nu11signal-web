---
// The screens section: three recordings of the real app (public/demo,
// encoded from the owner's GIFs). The overview is the main figure; SEARCH and
// the themes-and-quit recording sit below it as two cards.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const demo = (name: string) => `${base}demo/${name}`;

const recordings: { video: string; title: string; alt: string; caption: string }[] = [
  {
    video: 'search',
    title: 'SEARCH',
    alt: 'SEARCH in action: recent searches, live suggestions while typing, then an artist page with its top songs and albums, and a song playing',
    caption: 'Search the catalog.',
  },
  {
    video: 'themes',
    title: 'Themes and quit',
    alt: 'The SETTINGS panel switching the app between the BLUESHIFT, REDSHIFT and NEON ROSE themes, then quitting: the confirmation prompt and the shutdown',
    caption: 'Switch themes, then quit.',
  },
];
---

<section class="section" id="screens" aria-labelledby="screens-title">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Signal acquired</p>
      <h2 class="section-title" id="screens-title">The radio, in 80×24</h2>
      <p class="section-lede">Three recordings of the real app.</p>
    </div>

    <figure class="terminal">
      <video
        class="terminal__img"
        width="1278"
        height="702"
        loop
        muted
        playsinline
        controls
        preload="metadata"
        poster={demo('overview-poster.jpg')}
        aria-label="nu11signal in action: launching from the shell, the boot splash, opening a playlist, playing a song, and the data rain reacting to the music"
        data-demo
      >
        <source src={demo('overview.webm')} type="video/webm" />
        <source src={demo('overview.mp4')} type="video/mp4" />
      </video>
      <figcaption>Launch, open a playlist, play.</figcaption>
    </figure>

    <ul class="recordings">
      {
        recordings.map((rec) => (
          <li>
            <figure>
              <video
                width="1278"
                height="702"
                loop
                muted
                playsinline
                controls
                preload="none"
                poster={demo(`${rec.video}-poster.jpg`)}
                aria-label={rec.alt}
                data-demo
              >
                <source src={demo(`${rec.video}.webm`)} type="video/webm" />
                <source src={demo(`${rec.video}.mp4`)} type="video/mp4" />
              </video>
              <figcaption>
                <strong>{rec.title}</strong> — {rec.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // The demo starts itself unless the visitor prefers reduced motion; it
  // stays paused with its controls then (and without JS). Click, Enter or
  // Space pauses and resumes it.
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLVideoElement>('video[data-demo]').forEach((v) => {
    if (reduce) return;
    v.controls = false;
    v.tabIndex = 0;
    v.title = 'Click to pause or play';
    const toggle = () => (v.paused ? v.play() : v.pause());
    v.addEventListener('click', toggle);
    v.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
    v.play().catch(() => {
      v.controls = true;
    });
  });
</script>

<style>
  .terminal {
    margin: 0;
  }
  .terminal__img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px var(--dim),
      0 1.5rem 4rem -1rem var(--glow);
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 0.9375rem;
  }
  figcaption strong {
    color: var(--text);
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .recordings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.75rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 48rem) {
    .recordings {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .recordings figure {
    margin: 0;
  }
  .recordings video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow:
      0 0 0 1px var(--dim),
      0 1rem 3rem -1rem var(--glow);
  }
</style>
