---
import { INSTALL_COMMANDS, LINKS } from '../config';

const platforms = [
  { title: 'macOS', note: 'macOS 14+. Apple Music needs a subscription.', cmd: INSTALL_COMMANDS.macos },
  { title: 'Linux', note: 'x86_64 or ARM64, glibc. Your local music files.', cmd: INSTALL_COMMANDS.linux },
];
---

<section class="section" id="install" aria-labelledby="install-title">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Install</p>
      <h2 class="section-title" id="install-title">Tune in</h2>
      <p class="section-lede">
        One Homebrew command, then run <code>nu11signal</code>. See the{' '}
        <a href={LINKS.install} rel="noopener">install guide</a> or <a href={LINKS.releases} rel="noopener">GitHub Releases</a>.
      </p>
    </div>
    <div class="platforms">
      {
        platforms.map((p) => (
          <div>
            <h3>{p.title}</h3>
            <p>{p.note}</p>
            <pre><code>{p.cmd}</code></pre>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem 2.5rem;
  }
  .platforms h3 {
    margin: 0 0 0.25rem;
    color: var(--cyan);
    font-size: 1.0625rem;
  }
  .platforms p {
    margin: 0 0 0.75rem;
    color: var(--text-dim);
  }
  .section-lede code {
    color: var(--text);
  }
  pre {
    margin: 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--dim);
    border-left: 3px solid var(--yellow);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
