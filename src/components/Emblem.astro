---
// The null emblem as SVG dots, built from the exact Braille cells in the app
// (see src/emblem.ts): one circle per raised dot. The ring reads --ring and
// the slash --slash, so the emblem follows the active theme. With `glitch`,
// two tinted copies tear across it now and then (CSS only; off under
// prefers-reduced-motion or when the visitor turns the effects off).
import { EMBLEM_COMPACT, EMBLEM_LARGE, brailleDots, dotBounds, dotsPath } from '../emblem';

interface Props {
  /** Rendered height in CSS pixels; the width follows the emblem's shape. */
  size?: number;
  /** large: the 12 x 8 cell emblem; compact: the 8 x 6 one, for small marks. */
  variant?: 'large' | 'compact';
  /** Accessible name; leave empty when the emblem is decorative. */
  label?: string;
  glitch?: boolean;
  class?: string;
}

const { size = 40, variant = 'large', label = '', glitch = false, class: className } = Astro.props;
const dots = brailleDots(variant === 'compact' ? EMBLEM_COMPACT : EMBLEM_LARGE);
const box = dotBounds(dots);
const ring = dotsPath(dots, 'ring', box.x, box.y);
const slash = dotsPath(dots, 'slash', box.x, box.y);
const viewBox = `0 0 ${box.width} ${box.height}`;
const layers = glitch ? ['glitch__main', 'glitch__layer glitch__layer--a', 'glitch__layer glitch__layer--b'] : [''];
---

<span
  class:list={['emblem', { glitch }, className]}
  style={`height:${size}px;aspect-ratio:${box.width}/${box.height}`}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  {
    layers.map((layer) => (
      <svg class={layer || undefined} viewBox={viewBox} aria-hidden="true" focusable="false">
        <path class="emblem-ring" d={ring} />
        <path class="emblem-slash" d={slash} />
      </svg>
    ))
  }
</span>

<style>
  .emblem {
    display: inline-block;
    flex: none;
    width: auto;
  }
  .emblem :global(svg) {
    width: 100%;
    height: 100%;
  }
  .emblem :global(.emblem-ring) {
    fill: var(--ring);
  }
  .emblem :global(.emblem-slash) {
    fill: var(--slash);
  }
</style>
