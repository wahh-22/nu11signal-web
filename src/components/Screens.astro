---
// The terminal mock: the app's own 80x24 screen renders (copied from the
// app repo's docs/assets/screens). The main screen follows the site theme.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = (name: string) => `${base}screens/${name}.svg`;

const themes = [
  { id: 'blueshift', label: 'BLUESHIFT' },
  { id: 'redshift', label: 'REDSHIFT' },
  { id: 'matrix', label: 'MATRIX' },
  { id: 'rose', label: 'ROSE' },
  { id: 'neon-rose', label: 'NEON ROSE' },
];

const gallery = [
  {
    name: 'search',
    title: 'SEARCH',
    alt: 'SEARCH with live suggestions, matching artists and songs',
    caption: 'Live suggestions, recent searches, artists, albums, songs and playlists.',
  },
  {
    name: 'expanded',
    title: 'Expanded player',
    alt: 'The expanded player with the data rain under the transport controls',
    caption: 'f expands NOW PLAYING to the full width, rain and all.',
  },
  {
    name: 'no-signal',
    title: 'Signal effects',
    alt: 'A glitch burst tearing rows and flashing NO SIGNAL over the UI',
    caption: 'Torn rows, corrupted cells, static bars, and now and then NO SIGNAL.',
  },
  {
    name: 'keys',
    title: 'KEYS',
    alt: 'The KEYS overlay listing every binding by group',
    caption: '? opens every binding in one panel.',
  },
  {
    name: 'settings',
    title: 'SETTINGS',
    alt: 'The SETTINGS panel offering the BLUESHIFT, REDSHIFT, MATRIX, ROSE and NEON ROSE themes',
    caption: 's opens the themes: BLUESHIFT, REDSHIFT, MATRIX, ROSE or NEON ROSE; the choice is saved.',
  },
  {
    name: 'boot',
    title: 'Boot splash',
    alt: 'The boot splash: the logo over BOOTING NU11SIGNAL',
    caption: 'The app boots and shuts down over the logo.',
  },
];
---

<section class="section" id="screens" aria-labelledby="screens-title">
  <div class="container">
    <div class="section-head">
      <p class="section-kicker">Signal acquired</p>
      <h2 class="section-title" id="screens-title">The radio, in 80×24</h2>
      <p class="section-lede">
        Playlists on the dial at the left, NOW PLAYING with bracketed transport controls and data rain at the right.
        These are renders of the real UI.
      </p>
    </div>

    <figure class="terminal">
      {
        themes.map((t, i) => (
          <img
            class="terminal__img"
            data-theme-art={t.id}
            src={src(t.id)}
            width="840"
            height="556"
            alt={`nu11signal in the ${t.label} theme: the PLAYLISTS dial on the left, NOW PLAYING with transport buttons and data rain on the right`}
            loading={i === 0 ? undefined : 'lazy'}
            decoding="async"
          />
        ))
      }
      <figcaption>
        The main screen in the {themes.map((t) => <span data-theme-art={t.id}>{t.label}</span>)} theme, one of five:
        BLUESHIFT, REDSHIFT, MATRIX, ROSE and NEON ROSE. Switch the site theme above to see each one.
      </figcaption>
    </figure>

    <ul class="gallery">
      {
        gallery.map((shot) => (
          <li>
            <figure>
              <img src={src(shot.name)} width="840" height="556" alt={shot.alt} loading="lazy" decoding="async" />
              <figcaption>
                <strong>{shot.title}</strong> — {shot.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .terminal {
    margin: 0;
  }
  .terminal__img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px var(--dim),
      0 1.5rem 4rem -1rem var(--glow);
  }
  /* Only the active theme's render and name show; BLUESHIFT by default
     (also when <html> has no data-theme). */
  [data-theme-art] {
    display: none;
  }
  img[data-theme-art='blueshift'] {
    display: block;
  }
  span[data-theme-art='blueshift'] {
    display: inline;
  }
  :global(:root[data-theme='redshift']) [data-theme-art='blueshift'] {
    display: none;
  }
  :global(:root[data-theme='redshift']) img[data-theme-art='redshift'] {
    display: block;
  }
  :global(:root[data-theme='redshift']) span[data-theme-art='redshift'] {
    display: inline;
  }
  :global(:root[data-theme='matrix']) [data-theme-art='blueshift'] {
    display: none;
  }
  :global(:root[data-theme='matrix']) img[data-theme-art='matrix'] {
    display: block;
  }
  :global(:root[data-theme='matrix']) span[data-theme-art='matrix'] {
    display: inline;
  }
  :global(:root[data-theme='rose']) [data-theme-art='blueshift'] {
    display: none;
  }
  :global(:root[data-theme='rose']) img[data-theme-art='rose'] {
    display: block;
  }
  :global(:root[data-theme='rose']) span[data-theme-art='rose'] {
    display: inline;
  }
  :global(:root[data-theme='neon-rose']) [data-theme-art='blueshift'] {
    display: none;
  }
  :global(:root[data-theme='neon-rose']) img[data-theme-art='neon-rose'] {
    display: block;
  }
  :global(:root[data-theme='neon-rose']) span[data-theme-art='neon-rose'] {
    display: inline;
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 0.9375rem;
  }
  figcaption strong {
    color: var(--text);
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.75rem 1.5rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .gallery figure {
    margin: 0;
  }
  .gallery img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--dim);
  }
</style>
