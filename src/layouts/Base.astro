---
import '../styles/global.css';
import { SITE } from '../config';
import SignalGlitch from '../components/SignalGlitch.astro';

interface Props {
  title?: string;
  description?: string;
  /** For pages like 404: no canonical URL, kept out of search indexes. */
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = noindex ? new URL(base, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="night-city" data-fx="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#070707" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.shortTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The nu11signal null emblem beside N U 1 1 / S I G N A L" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=Kode+Mono:wght@400;600;700&display=swap"
    />

    <!-- Apply the saved theme and effects before first paint. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('nu11signal:theme');
          if (t === 'blue' || t === 'night-city') d.dataset.theme = t;
          var fx = localStorage.getItem('nu11signal:fx');
          if (fx === 'on' || fx === 'off') d.dataset.fx = fx;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <!-- Theme and effects toggles: [data-theme-toggle] and [data-fx-toggle].
         A manual theme pick dispatches nu11signal:theme-picked on document;
         nu11signal:set-theme (detail: 'night-city' | 'blue') switches the
         theme the same way, saved like a pick (the signal glitch uses it). -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        function save(key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (e) {}
        }
        function sync() {
          var blue = d.dataset.theme === 'blue';
          document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(blue));
            var l = b.querySelector('[data-label]');
            if (l) l.textContent = blue ? 'BLUE' : 'NIGHT CITY';
          });
          var on = d.dataset.fx !== 'off';
          document.querySelectorAll('[data-fx-toggle]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(on));
            var l = b.querySelector('[data-label]');
            if (l) l.textContent = on ? 'FX ON' : 'FX OFF';
          });
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', blue ? '#03050c' : '#070707');
        }
        function setTheme(theme) {
          d.dataset.theme = theme === 'blue' ? 'blue' : 'night-city';
          save('nu11signal:theme', d.dataset.theme);
          sync();
        }
        document.addEventListener('nu11signal:set-theme', function (e) {
          setTheme(e instanceof CustomEvent ? e.detail : '');
        });
        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target : null;
          if (!t) return;
          if (t.closest('[data-theme-toggle]')) {
            setTheme(d.dataset.theme === 'blue' ? 'night-city' : 'blue');
            document.dispatchEvent(new CustomEvent('nu11signal:theme-picked'));
          } else if (t.closest('[data-fx-toggle]')) {
            d.dataset.fx = d.dataset.fx === 'off' ? 'on' : 'off';
            save('nu11signal:fx', d.dataset.fx);
            sync();
          }
        });
        sync();
      })();
    </script>
    <SignalGlitch />
  </body>
</html>
