{
  "name": "nu11signal-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The nu11signal website: a terminal-native music player for Apple Music and local files.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "brand": "node tools/og-card.mjs && rsvg-convert -w 1200 -h 630 src/assets/og-card.svg -o public/og.png",
    "check:links": "node tools/check-links.mjs",
    "check:brand": "node tools/check-brand.mjs",
    "test": "node --test \"tools/**/*.test.mjs\"",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
