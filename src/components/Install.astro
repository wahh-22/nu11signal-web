---
// The install commands. In fit mode (global.css) INSTALL sits under the
// FEATURES cards on their shared screen (index.astro's .duo), its spacing
// and type growing with the window's height.
import { INSTALL_COMMANDS, LINKS } from '../config';
import Pane from './Pane.astro';

// Android has no install command: its card links the APK and the guides.
const platforms = [
  { title: 'macOS', note: 'macOS 14+. Apple Music needs a subscription.', cmd: INSTALL_COMMANDS.macos },
  {
    title: 'Linux',
    note: 'x86_64 or ARM64, glibc. Local files; Apple Music is experimental.',
    cmd: INSTALL_COMMANDS.linux,
  },
  {
    title: 'Android',
    note: 'Android 9+: TV, phones and tablets. Install the APK; newer versions are offered in the app.',
    links: [
      { href: LINKS.releases, label: 'APK on GitHub Releases' },
      { href: LINKS.androidTv, label: 'TV guide' },
      { href: LINKS.androidPhone, label: 'Phone and tablet guide' },
    ],
  },
];
---

<section class="section install-sec" id="install" aria-labelledby="install-title" data-section="INSTALL">
  <div class="container">
    <div class="section-head">
      <h2 class="section-kicker" id="install-title"><span data-scramble>Install</span></h2>
      <p class="section-lede">
        One Homebrew command on macOS and Linux, then run <code>nu11signal</code>; on Android, the APK. See the{' '}
        <a href={LINKS.install} rel="noopener">install guide</a> or <a href={LINKS.releases} rel="noopener">GitHub Releases</a>.
      </p>
    </div>
    <div class="platforms">
      {
        platforms.map((p) => (
          <Pane title={p.title} tag="h3" class="platform">
            <p>{p.note}</p>
            {p.cmd && (
              <pre><span class="prompt" aria-hidden="true">$ </span><code>{p.cmd}</code></pre>
            )}
            {p.links && (
              <p class="platform__links">
                {p.links.map((l) => (
                  <a href={l.href} rel="noopener">
                    {l.label} <span aria-hidden="true">→</span>
                  </a>
                ))}
              </p>
            )}
          </Pane>
        ))
      }
    </div>
  </div>
</section>

<style>
  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2rem 1.5rem;
  }
  .platform {
    padding: 1.6rem 1.25rem 1.25rem;
  }
  .platform p {
    margin: 0 0 0.75rem;
    color: var(--text-dim);
    font-size: 0.875rem;
  }
  .platform .platform__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
  }
  .section-lede code {
    color: var(--text);
  }
  pre {
    margin: 0;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--dim);
    border-left: 2px solid var(--yellow);
    background: var(--bg);
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .prompt {
    color: var(--accent-text);
  }

  @media (min-width: 52.0625rem) and (min-height: 35rem) {
    .install-sec {
      flex: none;
      padding-block: clamp(0.75rem, 3.6vh, 3rem) 0;
    }
    .install-sec .section-lede {
      margin-top: clamp(0.25rem, 1vh, 0.75rem);
      font-size: clamp(0.8125rem, 0.35rem + 1.15vh, 1.0625rem);
    }
    .platforms {
      gap: clamp(0.75rem, 2.4vh, 2rem) clamp(1rem, 2vw, 1.75rem);
    }
    .platform {
      padding: clamp(1.35rem, 3.4vh, 2.5rem) clamp(1.1rem, 2vw, 2rem) clamp(0.8rem, 2.4vh, 1.75rem);
    }
    .platform p {
      margin-bottom: clamp(0.5rem, 1.6vh, 1rem);
      font-size: clamp(0.8125rem, 0.35rem + 1.15vh, 1.0625rem);
    }
    pre {
      padding: clamp(0.55rem, 1.8vh, 1.15rem) clamp(0.85rem, 1.4vw, 1.25rem);
      font-size: clamp(0.8125rem, 0.35rem + 1.15vh, 0.9375rem);
    }
  }
</style>
