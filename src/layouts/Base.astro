---
import '../styles/global.css';
import { SITE } from '../config';
import SignalGlitch from '../components/SignalGlitch.astro';
import Boot from '../components/Boot.astro';
import StatusBar from '../components/StatusBar.astro';
import KeysDialog from '../components/KeysDialog.astro';
import Immersive from '../components/Immersive.astro';

interface Props {
  title?: string;
  description?: string;
  /** For pages like 404: no canonical URL, kept out of search indexes. */
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = noindex ? new URL(base, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="blueshift">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#03050c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.shortTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The NU11SIGNAL logo: a masked head with headphones and LED eyes beside the NU11SIGNAL wordmark" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400;600;700&display=swap"
    />

    <!-- Apply the saved theme before first paint. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('nu11signal:theme');
          // Renamed themes: 'night-city' is now 'redshift' and 'blue' is now
          // 'blueshift'. Keep returning visitors on their pick under its new id.
          var renamed = { 'night-city': 'redshift', blue: 'blueshift' };
          if (t && Object.prototype.hasOwnProperty.call(renamed, t)) {
            t = renamed[t];
            localStorage.setItem('nu11signal:theme', t);
          }
          // The site has three themes. Any other saved value (themes the site
          // no longer shows, or anything unknown) loads the default BLUESHIFT
          // and is rewritten.
          if (t && t !== 'blueshift' && t !== 'redshift' && t !== 'neon-rose') {
            t = 'blueshift';
            localStorage.setItem('nu11signal:theme', t);
          }
          if (t) d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Boot />
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <StatusBar />
    <KeysDialog />

    <!-- Theme toggle: [data-theme-toggle] (and the S key, Immersive.astro).
         The theme button cycles BLUESHIFT -> REDSHIFT -> NEON ROSE ->
         BLUESHIFT (BLUESHIFT is the default).
         A manual theme pick dispatches nu11signal:theme-picked on document;
         nu11signal:set-theme (detail: 'blueshift' | 'redshift' | 'neon-rose',
         or 'next' for the following theme in the cycle) switches the theme the
         same way, saved like a pick (the signal glitch uses 'next'). -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var THEMES = ['blueshift', 'redshift', 'neon-rose'];
        var LABELS = {
          blueshift: 'BLUESHIFT',
          redshift: 'REDSHIFT',
          'neon-rose': 'NEON ROSE',
        };
        var COLORS = {
          blueshift: '#03050c',
          redshift: '#070707',
          'neon-rose': '#060407',
        };
        function save(key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (e) {}
        }
        function current() {
          var t = d.dataset.theme;
          return THEMES.indexOf(t) >= 0 ? t : 'blueshift';
        }
        function next(theme) {
          return THEMES[(THEMES.indexOf(theme) + 1) % THEMES.length];
        }
        function sync() {
          var theme = current();
          var after = next(theme);
          document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
            b.setAttribute('data-current', theme);
            b.setAttribute('title', 'Color theme: ' + LABELS[theme] + '. Click for ' + LABELS[after] + '.');
            var l = b.querySelector('[data-label]');
            if (l) l.textContent = LABELS[theme];
            var n = b.querySelector('[data-next]');
            if (n) n.textContent = ', switch to ' + LABELS[after];
          });
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', COLORS[theme]);
        }
        function setTheme(theme) {
          if (theme === 'next') theme = next(current());
          d.dataset.theme = THEMES.indexOf(theme) >= 0 ? theme : 'blueshift';
          save('nu11signal:theme', d.dataset.theme);
          sync();
        }
        document.addEventListener('nu11signal:set-theme', function (e) {
          setTheme(e instanceof CustomEvent ? e.detail : '');
        });
        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target : null;
          if (!t) return;
          if (t.closest('[data-theme-toggle]')) {
            setTheme('next');
            document.dispatchEvent(new CustomEvent('nu11signal:theme-picked'));
          }
        });
        sync();
      })();
    </script>
    <SignalGlitch />
    <Immersive />
  </body>
</html>
