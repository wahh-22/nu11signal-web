---
import { INSTALL_COMMAND, LINKS, REPO } from '../config';

// The official logo, one file per theme in public/logo/. All five are in the
// page; CSS in global.css (.theme-art) shows the one matching
// <html data-theme>, so the logo follows a theme change at once. The glitch
// layers repeat the stack, tinted, and tear across it now and then.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const THEMES = ['night-city', 'blue', 'matrix', 'rose', 'neon-rose'] as const;
const logo = (theme: (typeof THEMES)[number]) => `${base}logo/nu11signal-${theme}.svg`;
const layers = ['glitch__main', 'glitch__layer glitch__layer--a', 'glitch__layer glitch__layer--b'];

const releaseBadge = `https://img.shields.io/github/v/release/${REPO}?style=for-the-badge&labelColor=0A0A0A&color=FF5F57&label=latest`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">nu11signal</span>
      <span class="hero__logo glitch" aria-hidden="true">
        {
          layers.map((layer) => (
            <span class:list={['theme-art', layer]}>
              {THEMES.map((theme) => (
                <img
                  class={`theme-art__img theme-art__img--${theme}`}
                  src={logo(theme)}
                  alt=""
                  width="1650"
                  height="520"
                  decoding="async"
                />
              ))}
            </span>
          ))
        }
      </span>
    </h1>

    <p class="hero__tagline">A cyberpunk car radio for Apple&nbsp;Music, in your terminal.</p>
    <p class="hero__lede">
      Your library playlists sit on a pseudo FM dial beside a now-playing panel, a volume readout, and data rain that
      plays the music. Search the Apple Music catalog, edit playlists, and love songs without leaving the terminal.
    </p>

    <div class="install" role="group" aria-label="Install with Homebrew">
      <span class="install__prompt" aria-hidden="true">$</span>
      <code class="install__cmd" id="install-cmd">{INSTALL_COMMAND}</code>
      <button type="button" class="hud-btn hud-btn--small install__copy" data-copy-target="install-cmd">
        <span data-copy-label>Copy</span>
      </button>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </div>

    <div class="hero__actions">
      <a class="hud-btn hud-btn--primary" href={LINKS.repo} rel="noopener">View on GitHub</a>
      <a class="hud-btn" href={LINKS.latestRelease} rel="noopener">Latest release</a>
    </div>

    <ul class="hero__meta">
      <li>
        <a href={LINKS.latestRelease} rel="noopener">
          <img src={releaseBadge} alt="Latest nu11signal release" height="28" loading="lazy" decoding="async" />
        </a>
      </li>
      <li class="chip">macOS 14+</li>
      <li class="chip">Apple Music subscription</li>
      <li class="chip">MIT</li>
    </ul>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var src = document.getElementById(btn.getAttribute('data-copy-target') || '');
        var label = btn.querySelector('[data-copy-label]');
        var status = btn.parentElement && btn.parentElement.querySelector('[data-copy-status]');
        if (!src) return;
        var text = src.textContent || '';
        function done(ok) {
          if (label) label.textContent = ok ? 'Copied' : 'Press ⌘C';
          if (status) status.textContent = ok ? 'Install command copied to the clipboard.' : 'Copy failed; select the command and copy it.';
          if (!ok) {
            var r = document.createRange();
            r.selectNodeContents(src);
            var s = window.getSelection();
            if (s) {
              s.removeAllRanges();
              s.addRange(r);
            }
          }
          setTimeout(function () {
            if (label) label.textContent = 'Copy';
          }, 2000);
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(
            function () {
              done(true);
            },
            function () {
              done(false);
            },
          );
        } else {
          done(false);
        }
      });
    });
  })();
</script>

<style>
  .hero {
    padding: clamp(3rem, 9vw, 6rem) 0 clamp(3rem, 7vw, 4.5rem);
    /* The glitch layers shift sideways; never let them widen the page. */
    overflow-x: clip;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__title {
    width: 100%;
    margin: 0;
    line-height: 0;
  }
  /* 1650 x 520 artwork: about 328 x 103 at a 360px phone, 46rem at most. */
  .hero__logo {
    display: block;
    width: min(100%, 46rem);
    aspect-ratio: 1650 / 520;
  }
  .hero__tagline {
    margin: 2rem 0 0;
    font-family: var(--font-ui);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 600;
    color: var(--cyan);
  }
  .hero__lede {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--text-dim);
  }
  .install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    width: 100%;
    max-width: 42rem;
    margin-top: 2rem;
    padding: 0.75rem 0.75rem 0.75rem 1rem;
    border: 1px solid var(--deep);
    border-left: 3px solid var(--yellow);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .install__prompt {
    color: var(--accent-text);
    font-family: var(--font-ui);
  }
  .install__cmd {
    flex: 1 1 16rem;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--text);
    font-size: 0.95rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero__meta img {
    height: 28px;
    width: auto;
  }
  .chip {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--muted);
    border-radius: 999px;
    color: var(--text-dim);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
  }
</style>
